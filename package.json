{
  "name": "@jfillman/clearance-ui",
  "version": "0.1.0",
  "description": "The Clearance web UI as a package: the design kit, the ClearanceTransport seam and the host-agnostic views (Clearances, Evidence, Exceptions, Attestations, Map, Policy). No @backstage/* import: a host supplies the transport. Backstage's plugin and the standalone shell in app/ are the two hosts.",
  "license": "Apache-2.0",
  "packageManager": "yarn@4.13.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/jfillman/clearance-ui"
  },
  "main": "dist/index.esm.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "backstage": {
    "role": "web-library"
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "backstage-cli package build",
    "clean": "backstage-cli package clean",
    "lint": "eslint 'src/**/*.{ts,tsx}'",
    "test": "backstage-cli package test",
    "tsc": "tsc",
    "check-dist": "node scripts/check-dist.mjs"
  },
  "peerDependencies": {
    "@material-ui/core": "^4.12.2",
    "react": "^17.0.0 || ^18.0.0",
    "react-dom": "^17.0.0 || ^18.0.0",
    "react-router-dom": "^6.3.0"
  },
  "devDependencies": {
    "@backstage/cli": "^0.36.5",
    "@backstage/cli-defaults": "^0.1.5",
    "@jest/environment-jsdom-abstract": "~30.2.0",
    "@material-ui/core": "^4.12.2",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^14.0.0",
    "@types/eslint-plugin-jsx-a11y": "^6",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "eslint": "^8.57.1",
    "eslint-plugin-jsx-a11y": "^6.10.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jest": "~30.2.0",
    "jsdom": "^27.1.0",
    "react": "^18.0.2",
    "react-dom": "^18.0.2",
    "react-router-dom": "^6.30.2",
    "typescript": "~5.8.0"
  }
}
